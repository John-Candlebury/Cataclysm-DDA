  {
    "id": "EOC_HUNGER_VIAL_XE",
    "type": "effect_on_condition",
    "//": "This is meant to only grant the amount of blood/ruach vitamins you pasively burn in a day. Anathema, gets the same as VAMPIRE4, try to not be an affront to nature next time.",
    "effect": [
      {
        "if": { "not": { "u_has_trait": "VAMPIRE4" } },
        "then": [ { "math": [ "u_calories() = u_calories() + 1750" ] }, { "math": [ "u_val('thirst') = 0" ] } ]
      },
      {
        "if": { "u_has_trait": "LILIN_TRAITS" },
        "then": [ { "math": [ "u_vitamin('lilin_ruach_vitamin') = u_vitamin('lilin_ruach_vitamin') + 240" ] } ]
      },
      {
        "if": { "u_has_any_trait": [ "VAMPIRE4", "VAMPIRE3", "VAMPIRE2", "VAMPIRE1" ] },
        "then": [
          { "math": [ "_blood_mult =0" ] },
          {
            "foreach": "array",
            "target": [ "VAMPIRE4", "VAMPIRE3", "VAMPIRE2", "VAMPIRE1" ],
            "var": { "context_val": "id" },
            "effect": [ { "if": { "u_has_trait": { "context_val": "id" } }, "then": { "math": [ "_blood_mult++" ] } } ]
          },
          { "math": [ "u_vitamin('vit_blood') = u_vitamin('vit_blood') + 120 * _blood_mult" ] }
        ]
      }
    ]
  },
