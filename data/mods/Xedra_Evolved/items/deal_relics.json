  {
    "type": "effect_on_condition",
    "id": "EOC_DEAL_REBIRTH",
    "eoc_type": "PREVENT_DEATH",
    "//": "This is some ancient dream magic from the Highland empire.  It doesn't work on the dreamless, and it also only works in proper dimensions.",
    "condition": {
      "and": [
        { "math": [ "u_prevent_death_deal = 1" ] },
        { "not": { "u_has_trait": "VAMPIRE4" } },
        { "or": [ { "current_dimension": "default" }, { "current_dimension": "highlands" } ] }
      ]
    },
    "effect": [
      {
        "if": { "or": [ { "not": { "one_in_chance": 10 } }, { "math": [ "u_times_revived_by_deal < 7" ] } ] },
        "then": [
          {
            "u_message": "You think to see a shattered moon looming above your nightmare, but the vision is as fleeting as it is disturbing.",
            "popup": true
          },
          {
            "if": { "math": [ "u_times_revived_by_deal > 7" ] },
            "then": {
              "u_message": "The remnants of the moon loom ever larger in your dreams, their presence undeniable and foreboding.",
              "popup": true
            }
          },
          { "math": [ "u_times_revived_by_deal++" ] },
          { "run_eocs": [ "EOC_PERENNIAL_REBIRTH_HEAL" ] },
          {
            "if": { "current_dimension": "highlands" },
            "then": [
              { "u_location_variable": { "u_val": "highland" }, "target_params": { "om_terrain": "highlands", "z": 0 } },
              { "u_teleport": { "u_val": "safe_highland" } }
            ],
            "else": [
              { "u_location_variable": { "u_val": "forest" }, "target_params": { "om_terrain": "forest", "z": 0 } },
              { "u_teleport": { "u_val": "forest" } }
            ]
          }
        ],
        "else": [ { "u_message": "The dream shatters and the cold grip of death takes you for good.", "popup": true } ]
      }
    ]
  },
